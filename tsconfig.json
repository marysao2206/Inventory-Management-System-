{
  "compilerOptions": {
    "target": "ES2021",
    "module": "nodenext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "src/modules/dashboard/**",
    "src/modules/suppliers/**",
    "src/modules/inventory/**",
    "src/modules/logs/**"
  ]
}
